(function () {
  if (window.bscOnReady) return;
  window.bscOnReady = function (callback, chatbotId) {
    var id = chatbotId || 'chatbot';
    function find() {
      var el = document.getElementById(id);
      return (el && el.shadowRoot) ? el : null;
    }
    var existing = find();
    if (existing) { callback(existing, existing.shadowRoot); return; }
    var observer = new MutationObserver(function () {
      var el = find();
      if (el) {
        observer.disconnect();
        callback(el, el.shadowRoot);
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
